# ============================================================================
# MERCATOR CRM — CONFIGURATION D'ENVIRONNEMENT (.env.example)
# Aucun secret réel ne doit être commité dans ce fichier ni dans Git.
# ============================================================================

# Port du serveur HTTP Full-Stack (Express + Vite Middleware)
PORT=3000

# Environnement d'exécution (development | test | production)
NODE_ENV=development

# Chemin du fichier de base de données relationnelle SQLite (ou ":memory:" pour les tests)
DB_PATH=./data/mercator.sqlite

# Secret de signature de session / jeton interne (remplacer en production par 32+ octets aléatoires)
SESSION_SECRET=remplacer_par_un_secret_cryptographique_de_32_caracteres_minimum

# Limite de débit API par fenêtre de 15 minutes (protection anti-abus)
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_EXPORT_MAX=20

# URL publique de l'application (injectée automatiquement sur Cloud Run / AI Studio)
APP_URL="http://localhost:3000"

# Optionnel : Clé API Gemini (uniquement si un module d'aide à la rédaction serveur est activé)
GEMINI_API_KEY=""
